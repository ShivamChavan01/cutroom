# Server-only. Copy to .env.local and restart Vite or the local app server.
# Never prefix a secret with VITE_. Never commit .env.local.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# For OpenAI, set AI_PROVIDER=openai and fill the two fields below.
OPENAI_API_KEY=
# Choose a Responses API model available to your OpenAI account.
OPENAI_MODEL=
# For River, set AI_PROVIDER=river and supply a River API key.
RIVER_API_KEY=
RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Vercel only: require a separate demo access code before making paid requests.
# Set this in Vercel environment variables, never with a VITE_ prefix.
ASSISTANT_ACCESS_CODE=
